# GitHub Configuration
GITHUB_TOKEN=your_github_token_here

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# LLM Provider Configuration
LLM_PROVIDER_PREFERENCE=google_genai,groq,openai,huggingface,fallback
DEFAULT_TEMPERATURE=0.39
DEFAULT_MODEL=gemini-2.5-flash-preview-05-20

# API Keys (fill in the ones you have)
HUGGINGFACEHUB_API_TOKEN=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# Cache Configuration
CACHE_DEFAULT_TTL_SECONDS=86400
CACHE_ANALYSIS_TTL=86400
CACHE_TEMPLATE_TTL=604800
CACHE_AGENT_STATE_TTL=600
CACHE_FALLBACK_ENABLED=true

# Application Configuration
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=4
DEBUG=false
LOG_LEVEL=INFO

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# Agent Configuration
MAX_LLM_RETRIES=3
MAX_AGENT_CONCURRENCY=5
AGENT_TIMEOUT_SECONDS=300

# Template Configuration
TEMPLATES_DIR=templates
TEMPLATES_HOT_RELOAD=true
